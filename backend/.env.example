# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/grimorio"

# Segurança: gere com
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Endereços
FRONTEND_URL="http://localhost:5173"
PORT=3000

# Contas não confirmadas
UNVERIFIED_ACCOUNT_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=15

# E-mail. Escolha UMA opção; sem nenhuma, em desenvolvimento o e-mail só aparece no terminal.
# Ordem de preferência quando há mais de uma: Brevo, Resend, SMTP.
MAIL_FROM="Grimório <no-reply@seudominio.com>"

# Opção A: API do Brevo (funciona em hospedagens que bloqueiam SMTP).
# Sem domínio próprio, use um remetente verificado no Brevo.
BREVO_API_KEY=

# Opção B: API do Resend (para enviar a qualquer destinatário, precisa de domínio verificado)
RESEND_API_KEY=

# Opção C: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
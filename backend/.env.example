# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/grimorio"

# Segurança: gere com
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Endereços
FRONTEND_URL="http://localhost:5173"
PORT=3000

# Contas não confirmadas
UNVERIFIED_ACCOUNT_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=15

# E-mail. Escolha UMA opção; sem nenhuma, em desenvolvimento o e-mail só aparece no terminal.
MAIL_FROM="Grimório <no-reply@seudominio.com>"

# Opção A: API do Resend (funciona em hospedagens que bloqueiam SMTP)
RESEND_API_KEY=

# Opção B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/grimorio"

# Segurança: gere com
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Endereços
FRONTEND_URL="http://localhost:5173"
PORT=3000

# Contas não confirmadas
UNVERIFIED_ACCOUNT_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=15

# E-mail. Escolha UMA opção; sem nenhuma, em desenvolvimento o e-mail só aparece no terminal.
# Se houver mais de uma configurada, a ordem de preferência é: Brevo, Resend e SMTP.
# O MAIL_FROM vale para as três (com Brevo, o endereço precisa estar verificado no painel).
MAIL_FROM="Grimório <seu-email@exemplo.com>"

# Opção A: API do Brevo (funciona sem domínio próprio e em hospedagens que bloqueiam SMTP).
# Crie a chave com a permissão "Transactional email" e nada mais.
BREVO_API_KEY=

# Opção B: API do Resend (para enviar a qualquer destinatário, precisa de domínio verificado)
RESEND_API_KEY=

# Opção C: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=